{
  "allowed_file_suffixes": [
    ".bmp",
    ".csv",
    ".jpeg",
    ".jpg",
    ".json",
    ".md",
    ".png",
    ".txt"
  ],
  "maximum_archive_bytes": 5000000000,
  "maximum_compression_ratio": 200.0,
  "maximum_member_uncompressed_bytes": 500000000,
  "maximum_members": 200000,
  "maximum_path_depth": 16,
  "maximum_path_utf8_bytes": 1024,
  "maximum_total_path_utf8_bytes": 100000000,
  "maximum_total_uncompressed_bytes": 20000000000,
  "minimum_free_bytes_after_extraction": 1000000000,
  "read_chunk_bytes": 1048576,
  "schema_version": "cvi.public_dataset_archive_policy.v1",
  "verify_member_crc": true
}
