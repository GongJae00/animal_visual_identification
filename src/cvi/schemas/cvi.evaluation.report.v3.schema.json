{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvi.evaluation.report.v3",
  "title": "CVI Protected Evaluation Report v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "protocol_status",
    "receipt_chain_verified",
    "valid_for_model_selection",
    "valid_for_final_reporting",
    "evaluation_token",
    "receipt_chain",
    "protocol_configuration",
    "input_summary",
    "metrics",
    "resource_bounds",
    "evaluator_provenance_sha256",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "cvi.evaluation.report.v3"},
    "protocol": {"const": "protected_retrieval"},
    "protocol_status": {"const": "RECEIPT_CHAIN_VERIFIED"},
    "receipt_chain_verified": {"const": true},
    "valid_for_model_selection": {"const": false},
    "valid_for_final_reporting": {"const": false},
    "evaluation_token": {"$ref": "#/$defs/sha256"},
    "receipt_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_receipt_sha256",
        "policy_receipt_sha256",
        "input_receipt_sha256",
        "advanced_exposure_declaration_sha256",
        "split_assignment_sha256",
        "prior_exposure_ledger_sha256",
        "prior_exposure_receipt_sha256"
      ],
      "properties": {
        "plan_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "policy_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "input_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "advanced_exposure_declaration_sha256": {"$ref": "#/$defs/sha256"},
        "split_assignment_sha256": {"$ref": "#/$defs/sha256"},
        "prior_exposure_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "prior_exposure_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "score_dtype", "self_match_policy", "aggregation", "tie_policy", "rank_ks", "bootstrap_resamples", "bootstrap_seed"],
      "properties": {
        "metric": {"const": "cosine"},
        "score_dtype": {"const": "float64"},
        "self_match_policy": {"const": "exclude"},
        "aggregation": {"const": "max"},
        "tie_policy": {"const": "stable_first_gallery_identity_occurrence"},
        "rank_ks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "bootstrap_resamples": {"type": "integer", "minimum": 1},
        "bootstrap_seed": {"type": "integer", "minimum": 0}
      }
    },
    "input_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gallery_templates", "query_templates", "gallery_identities", "query_identities", "embedding_dimension", "total_embedding_values", "score_matrix_elements"],
      "properties": {
        "gallery_templates": {"type": "integer", "minimum": 1},
        "query_templates": {"type": "integer", "minimum": 1},
        "gallery_identities": {"type": "integer", "minimum": 1},
        "query_identities": {"type": "integer", "minimum": 1},
        "embedding_dimension": {"type": "integer", "minimum": 1},
        "total_embedding_values": {"type": "integer", "minimum": 1},
        "score_matrix_elements": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mAP", "mINP", "MRR", "rank_at_k", "identity_clustered_bootstrap"],
      "properties": {
        "mAP": {"$ref": "#/$defs/unitNumber"},
        "mINP": {"$ref": "#/$defs/unitNumber"},
        "MRR": {"$ref": "#/$defs/unitNumber"},
        "rank_at_k": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["k", "value"],
            "properties": {
              "k": {"type": "integer", "minimum": 1},
              "value": {"$ref": "#/$defs/unitNumber"}
            }
          }
        },
        "identity_clustered_bootstrap": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/bootstrapInterval"}
        }
      }
    },
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_samples_per_input", "maximum_embedding_dimension", "maximum_total_embedding_values", "maximum_score_matrix_elements"],
      "properties": {
        "maximum_samples_per_input": {"type": "integer", "minimum": 1},
        "maximum_embedding_dimension": {"type": "integer", "minimum": 1},
        "maximum_total_embedding_values": {"type": "integer", "minimum": 1},
        "maximum_score_matrix_elements": {"type": "integer", "minimum": 1}
      }
    },
    "evaluator_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "interpretation": {"const": "RECEIPT_CHAIN_INTEGRITY_ONLY_SCIENTIFIC_VALIDITY_REQUIRES_EXTERNAL_PROTOCOL_MODEL_DATA_REVIEW"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unitNumber": {"type": "number", "minimum": 0, "maximum": 1},
    "bootstrapInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "estimate", "lower_bound", "upper_bound", "confidence_level", "cluster_unit", "cluster_count", "query_row_count", "resamples", "seed", "interval_method"],
      "properties": {
        "metric": {"type": "string", "minLength": 1, "maxLength": 32},
        "estimate": {"$ref": "#/$defs/unitNumber"},
        "lower_bound": {"$ref": "#/$defs/unitNumber"},
        "upper_bound": {"$ref": "#/$defs/unitNumber"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "cluster_unit": {"const": "query_identity"},
        "cluster_count": {"type": "integer", "minimum": 2},
        "query_row_count": {"type": "integer", "minimum": 1},
        "resamples": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "interval_method": {"const": "whole_identity_percentile_bootstrap"}
      }
    }
  }
}
