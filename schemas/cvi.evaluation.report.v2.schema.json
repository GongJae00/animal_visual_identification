{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvi.evaluation.report.v2",
  "title": "CVI Evaluation Report v2",
  "type": "object",
  "required": ["protocol", "provenance", "protocol_status"],
  "properties": {
    "protocol": {"type": "string", "enum": ["verification", "retrieval", "open_set"]},
    "protocol_status": {"type": "string", "enum": ["VERIFIED", "UNVERIFIED", "INVALID", "RELAXED_UNSAFE"]},
    "provenance": {
      "type": "object",
      "required": ["schema_version", "git_commit", "git_branch", "dirty_state", "start_timestamp", "python_version", "numpy_version"],
      "properties": {
        "schema_version": {"const": "cvi.evaluation.report.v2"},
        "git_commit": {"type": "string"},
        "git_branch": {"type": "string"},
        "dirty_state": {"type": ["boolean", "string"]},
        "start_timestamp": {"type": "string"},
        "end_timestamp": {"type": "string"},
        "python_version": {"type": "string"},
        "numpy_version": {"type": "string"},
        "scikit_learn_version": {"type": "string"},
        "jsonschema_version": {"type": "string"},
        "platform": {"type": "string"},
        "machine": {"type": "string"},
        "baseline_commit": {"type": "string"}
      }
    },
    "valid_for_model_selection": {"type": "boolean"},
    "valid_for_final_reporting": {"type": "boolean"},
    "evidence_config": {"type": "object"},
    "calibration_pairs": {"type": "object"},
    "test_pairs": {"type": "object"},
    "gallery": {"type": "object"},
    "queries": {"type": "object"},
    "test_queries": {"type": "object"},
    "schema": {"type": "object"},
    "schema_sha256": {"type": "string"},
    "warnings": {"type": ["array", "null"], "items": {"type": "string"}},
    "calibration_pair_count": {"type": "integer"},
    "test_pair_count": {"type": "integer"},
    "channels": {"type": "array"},
    "thresholds": {"type": "object"},
    "num_queries": {"type": "integer"},
    "num_gallery": {"type": "integer"},
    "num_valid_queries": {"type": "integer"},
    "mAP": {"type": "number"},
    "mINP": {"type": "number"},
    "Rank-1": {"type": "number"},
    "Rank-5": {"type": "number"},
    "Rank-10": {"type": "number"},
    "known_detection_AUROC": {"type": "number"},
    "known_detection_AUPR": {"type": "number"},
    "DIR_at_FPIR": {"type": "object"},
    "FPIR_thresholds": {"type": "object"},
    "per_target": {"type": "object"},
    "known_correct_accept_count": {"type": "integer"},
    "known_misidentification_count": {"type": "integer"},
    "known_rejection_count": {"type": "integer"},
    "unknown_accept_count": {"type": "integer"},
    "unknown_rejection_count": {"type": "integer"},
    "num_enrolled_queries": {"type": "integer"},
    "num_unknown_queries": {"type": "integer"},
    "num_gallery_identities": {"type": "integer"}
  }
}
